<?xml version="1.0" encoding="UTF-8"?>
<net version="1.9" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/net_file.xsd">
    <location netOffset="0.00,0.00" convBoundary="-500.00,-500.00,500.00,500.00" origBoundary="-500.00,-500.00,500.00,500.00" projParameter="!"/>

    <type id="urban" numLanes="2" speed="13.89"/>

    <!-- External nodes -->
    <node id="W" x="-500.0" y="0.0" type="priority"/>
    <node id="E" x="500.0" y="0.0" type="priority"/>
    <node id="N" x="0.0" y="500.0" type="priority"/>
    <node id="S" x="0.0" y="-500.0" type="priority"/>
    <node id="C" x="0.0" y="0.0" type="traffic_light"/>

    <!-- Incoming edges -->
    <edge id="west_in" from="W" to="C" priority="1" type="urban">
        <lane id="west_in_0" index="0" speed="13.89" length="500"/>
        <lane id="west_in_1" index="1" speed="13.89" length="500"/>
    </edge>
    <edge id="east_in" from="E" to="C" priority="1" type="urban">
        <lane id="east_in_0" index="0" speed="13.89" length="500"/>
        <lane id="east_in_1" index="1" speed="13.89" length="500"/>
    </edge>
    <edge id="north_in" from="N" to="C" priority="1" type="urban">
        <lane id="north_in_0" index="0" speed="13.89" length="500"/>
        <lane id="north_in_1" index="1" speed="13.89" length="500"/>
    </edge>
    <edge id="south_in" from="S" to="C" priority="1" type="urban">
        <lane id="south_in_0" index="0" speed="13.89" length="500"/>
        <lane id="south_in_1" index="1" speed="13.89" length="500"/>
    </edge>

    <!-- Outgoing edges -->
    <edge id="west_out" from="C" to="W" priority="1" type="urban">
        <lane id="west_out_0" index="0" speed="13.89" length="500"/>
        <lane id="west_out_1" index="1" speed="13.89" length="500"/>
    </edge>
    <edge id="east_out" from="C" to="E" priority="1" type="urban">
        <lane id="east_out_0" index="0" speed="13.89" length="500"/>
        <lane id="east_out_1" index="1" speed="13.89" length="500"/>
    </edge>
    <edge id="north_out" from="C" to="N" priority="1" type="urban">
        <lane id="north_out_0" index="0" speed="13.89" length="500"/>
        <lane id="north_out_1" index="1" speed="13.89" length="500"/>
    </edge>
    <edge id="south_out" from="C" to="S" priority="1" type="urban">
        <lane id="south_out_0" index="0" speed="13.89" length="500"/>
        <lane id="south_out_1" index="1" speed="13.89" length="500"/>
    </edge>

    <tlLogic id="C" type="static" programID="0" offset="0">
        <phase duration="30" state="GGrrrrGGrrrr"/>
        <phase duration="3"  state="yyrrrryyrrrr"/>
        <phase duration="30" state="rrGGrrrrGGrr"/>
        <phase duration="3"  state="rryyrrrryyrr"/>
    </tlLogic>

    <connection from="west_in" to="east_out" fromLane="0" toLane="0"/>
    <connection from="west_in" to="east_out" fromLane="1" toLane="1"/>
    <connection from="east_in" to="west_out" fromLane="0" toLane="0"/>
    <connection from="east_in" to="west_out" fromLane="1" toLane="1"/>
    <connection from="north_in" to="south_out" fromLane="0" toLane="0"/>
    <connection from="north_in" to="south_out" fromLane="1" toLane="1"/>
    <connection from="south_in" to="north_out" fromLane="0" toLane="0"/>
    <connection from="south_in" to="north_out" fromLane="1" toLane="1"/>
</net>
